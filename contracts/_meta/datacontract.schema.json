{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lumen data contract (lumen.datacontract/v1)",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "info", "dataset", "schema", "freshness", "breaking_change_policy", "changelog"],
  "properties": {
    "apiVersion": {"const": "lumen.datacontract/v1"},
    "kind": {"const": "DataContract"},
    "id": {"type": "string", "pattern": "^[a-z0-9_.]+$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "status": {"enum": ["draft", "active", "deprecated"]},
    "info": {
      "type": "object",
      "required": ["title", "producer", "consumers"],
      "properties": {
        "consumers": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["team", "use"]}}
      }
    },
    "dataset": {
      "type": "object",
      "required": ["table", "primary_key", "grain"],
      "properties": {
        "table": {"type": "string"},
        "primary_key": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "schema": {
      "type": "object",
      "required": ["columns"],
      "properties": {
        "additional_columns": {"enum": ["forbid", "allow"]},
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "type", "nullable"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
              "type": {"type": "string"},
              "nullable": {"type": "boolean"},
              "description": {"type": "string"},
              "pattern": {"type": "string"},
              "allowed_values": {"type": "array", "minItems": 1},
              "range": {"type": "object", "properties": {"min": {}, "max": {}}, "additionalProperties": false},
              "references": {"type": "object", "required": ["table", "column"]}
            }
          }
        }
      }
    },
    "quality": {"type": "object"},
    "freshness": {
      "type": "object",
      "required": ["column", "warn_after_hours", "error_after_hours"],
      "properties": {
        "warn_after_hours": {"type": "number", "exclusiveMinimum": 0},
        "error_after_hours": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "breaking_change_policy": {"type": "object", "required": ["versioning", "breaking", "non_breaking"]},
    "changelog": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "required": ["version", "summary"]}
    }
  }
}
